# Copy to .env and fill in.

# LTA DataMall account key (request at https://datamall.lta.gov.sg)
DATAMALL_KEY=

# MySQL: root is used only by etl/init_mysql.py to create the schema and app accounts.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=transport
MYSQL_ROOT_PASSWORD=rootpass
# Least-privilege accounts created by sql/05_users.sql
MYSQL_RW_USER=app_rw
MYSQL_RW_PASSWORD=app_rw_pass
MYSQL_RO_USER=app_ro
MYSQL_RO_PASSWORD=app_ro_pass

# MongoDB. MONGO_PORT is the host port docker compose publishes; keep it equal to the port in MONGO_URI.
MONGO_PORT=27017
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=transport

# Flask
FLASK_SECRET_KEY=change-me

# Collector: seconds between polling rounds, number of stops to watch
COLLECTOR_INTERVAL=90
COLLECTOR_STOP_COUNT=100
